# Local router connection. Keep your real .env file private.
ROUTER_HOST=192.168.1.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=change-me

# Safer default: only this computer can open the dashboard.
# Set to 0.0.0.0 only when you intentionally want LAN/phone access.
BIND_HOST=127.0.0.1
PORT=3456

# Optional: choose another private data file outside the repository.
# DATA_FILE=C:\\path\\to\\usage.json
