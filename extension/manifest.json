{
  "manifest_version": 3,
  "name": "Airtel Data Pulse",
  "version": "1.0.0",
  "description": "A local-first usage, renewal, and network dashboard for compatible Airtel and MTN routers.",
  "action": {
    "default_title": "Open Airtel Data Pulse"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://speed.cloudflare.com/*"
  ]
}
