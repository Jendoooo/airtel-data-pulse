{
  "manifest_version": 3,
  "name": "Airtel Data Pulse",
  "version": "0.1.0",
  "description": "A private, simple view of daily Airtel router data usage.",
  "action": {
    "default_title": "Open Airtel Data Pulse",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
